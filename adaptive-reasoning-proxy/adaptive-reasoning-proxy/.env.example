# --- LLM backend (any OpenAI-compatible server, e.g. llama-server) ----------
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=none

# --- Threshold store --------------------------------------------------------
# Optional. If Redis is unreachable the proxy falls back to in-memory + defaults.
REDIS_URL=redis://localhost:6379

# --- Embedding-based classifier (Priority 3) --------------------------------
# "1" to route prompts via embeddings; "0" (default) uses the regex classifier.
EMBEDDINGS_ENABLED=0
EMBEDDING_MODEL=text-embedding-3-small
# Defaults to LLM_BASE_URL / LLM_API_KEY if unset:
# EMBEDDING_BASE_URL=http://localhost:8080/v1
# EMBEDDING_API_KEY=none

# --- Query log / savings estimate knobs -------------------------------------
# QUERY_LOG_DB=proxy/query_log.db
BASELINE_TOKENS=256
COST_PER_1K_TOKENS=0.60
