# --- LLM backend (any OpenAI-compatible server, e.g. llama-server) ----------
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=none

# --- Threshold store --------------------------------------------------------
# Optional. If Redis is unreachable the proxy falls back to in-memory + defaults.
REDIS_URL=redis://localhost:6379

# --- Query log / savings estimate knobs -------------------------------------
# QUERY_LOG_DB=proxy/query_log.db
BASELINE_TOKENS=256
COST_PER_1K_TOKENS=0.60
